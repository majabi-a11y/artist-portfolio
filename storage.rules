rules_version = '2';
// À coller dans la console Firebase : Storage → Règles → Publier.
// Images importées depuis l'admin : lisibles par tous, envoyées seulement par les comptes listés.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['adrien.enaer@gmail.com', 'myriam.ajabi@gmail.com'];
    }
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
